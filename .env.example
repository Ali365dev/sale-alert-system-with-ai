# Gmail OAuth2
# Download credentials.json from Google Cloud Console → APIs & Services → Credentials
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json
GMAIL_LABEL=sales_offers

# Gemini API (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Supabase PostgreSQL connection string
# Find it in: Supabase Dashboard → Project Settings → Database → Connection string (URI mode)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Ollama — local Llama agent (final fallback, no API key required)
# Install Ollama: https://ollama.com  |  then: ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Optional SMTP for forgot-password emails (mobile + web). If unset, the
# app falls back to sending via the connected Gmail OAuth account
# (gmail.modify). For local testing without either, set
# PASSWORD_RESET_DEV_ECHO=true to return `dev_code` in the API response —
# never enable that in production.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com
# SMTP_USE_TLS=true
# PASSWORD_RESET_DEV_ECHO=false
# PASSWORD_RESET_CODE_TTL_MINUTES=15

# Personalized feed + FCM matching (services/offer_matching.py).
# "or"  = brand match OR category match is enough (recommended with few
#         offers per brand — "and" can produce an empty feed/no
#         notifications even for users with real saved preferences).
# "and" = brand AND at least one category must match.
OFFER_MATCH_MODE=or
