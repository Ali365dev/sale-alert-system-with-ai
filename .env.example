# Gmail OAuth2
# Download credentials.json from Google Cloud Console → APIs & Services → Credentials
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json
GMAIL_LABEL=sales_offers

# Gemini API (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Supabase PostgreSQL connection string
# Find it in: Supabase Dashboard → Project Settings → Database → Connection string (URI mode)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Ollama — local Llama agent (final fallback, no API key required)
# Install Ollama: https://ollama.com  |  then: ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
