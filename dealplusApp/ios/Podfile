# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

target 'dealplusApp' do
  # React Native Firebase resolves the Firebase Apple SDK via Swift Package
  # Manager by default (RN 0.75+), which requires dynamic frameworks instead
  # of this project's previous static-library linkage.
  # See: https://rnfirebase.io/ (iOS SPM Support / "Altering CocoaPods to use frameworks")
  use_frameworks! :linkage => :dynamic

  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # RNCClipboard's use of the legacy MobileCoreServices API triggers a
    # bogus 'UIUtilities' auto-link on current Xcode/SDKs, which then blocks
    # MobileCoreServices itself from being linked and leaves UTTypeConformsTo
    # undefined. Disable module auto-linking for that pod and link it manually.
    installer.pods_project.targets.each do |target|
      next unless target.name == 'RNCClipboard'

      target.build_configurations.each do |config|
        config.build_settings['CLANG_MODULES_AUTOLINK'] = 'NO'
        ldflags = Array(config.build_settings['OTHER_LDFLAGS'] || ['$(inherited)'])
        ldflags += ['-framework', 'MobileCoreServices']
        config.build_settings['OTHER_LDFLAGS'] = ldflags
      end
    end
  end
end
